generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String

  urls      Url[]

  createdAt DateTime @default(now())
}

model Url {
  id          String   @id @default(uuid())
  originalUrl String
  shortCode   String   @unique
  clickCount  Int      @default(0)

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())
}